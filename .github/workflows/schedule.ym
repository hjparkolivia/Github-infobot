name: Daily App Marketing Bot

on:
  schedule:
    # 한국 시간 매일 오전 09:17
    - cron: "17 0 * * *"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: daily-app-marketing-bot
  cancel-in-progress: false

jobs:
  send-digest:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    env:
      GEMINI_KEY: ${{ secrets.APIKEY_GEMINI }}
      TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
      TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      GEMINI_MODEL: gemini-3.5-flash
      PYTHONUNBUFFERED: "1"

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check required secrets
        shell: bash
        run: |
          missing=0

          if [[ -z "${GEMINI_KEY//[[:space:]]/}" ]]; then
            echo "::error::APIKEY_GEMINI Secret을 읽지 못했습니다."
            missing=1
          fi

          if [[ -z "${TELEGRAM_TOKEN//[[:space:]]/}" ]]; then
            echo "::error::TELEGRAM_TOKEN Secret을 읽지 못했습니다."
            missing=1
          fi

          if [[ -z "${TELEGRAM_CHAT_ID//[[:space:]]/}" ]]; then
            echo "::error::TELEGRAM_CHAT_ID Secret을 읽지 못했습니다."
            missing=1
          fi

          if [[ "$missing" -ne 0 ]]; then
            exit 1
          fi

          echo "필수 Secret 3개 연결 확인 완료"

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: python -m pip install --upgrade -r requirements.txt

      - name: Run marketing bot
        run: python bot.py
